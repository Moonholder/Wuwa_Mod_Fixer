# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Force source code and configuration files to strictly use LF
*.rs text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.dds binary
*.exe binary
*.zip binary
*.ico binary
